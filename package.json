{
  "name": "kitchenprime",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma db push --skip-generate --accept-data-loss && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "build:icons": "node scripts/build-icons.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:seo": "playwright test tests/e2e/seo.spec.ts",
    "test:perf": "playwright test tests/e2e/perf.spec.ts",
    "test:lighthouse": "lhci autorun",
    "typecheck": "tsc --noEmit",
    "build:app": "prisma generate && next build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "check:images": "node scripts/check-images.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "next": "^14.2.18",
    "next-auth": "^4.24.14",
    "next-intl": "^3.26.0",
    "nodemailer": "^7.0.7",
    "pdfkit": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
